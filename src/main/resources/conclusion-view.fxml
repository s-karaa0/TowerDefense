<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="resultRoot" prefHeight="500.0" prefWidth="700.0" styleClass="result-screen" stylesheets="@style/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.towerdefense.ConclusionController">
    <children>
        <VBox alignment="CENTER" spacing="18.0" AnchorPane.bottomAnchor="32.0" AnchorPane.leftAnchor="32.0" AnchorPane.rightAnchor="32.0" AnchorPane.topAnchor="32.0">
            <children>
                <Label styleClass="result-eyebrow" text="DIE KRONENLAND-CHRONIK" />
                <Label fx:id="win" alignment="CENTER" maxWidth="600.0" styleClass="result-title result-title-win" text="SIEG!" textAlignment="CENTER" wrapText="true" />
                <Label fx:id="lose" alignment="CENTER" maxWidth="600.0" styleClass="result-title result-title-lose" text="DIE BURG IST GEFALLEN" textAlignment="CENTER" wrapText="true" />
                <Label fx:id="resultMessage" alignment="CENTER" maxWidth="540.0" styleClass="result-message" textAlignment="CENTER" wrapText="true" />
                <Label styleClass="result-ornament" text="✦   ━━━━━━━━━   ✦" />
                <VBox alignment="CENTER" maxWidth="360.0" spacing="12.0" styleClass="result-card">
                    <children>
                        <Button fx:id="restartButton" maxWidth="280.0" mnemonicParsing="false" onAction="#onRestartClicked" prefHeight="48.0" styleClass="result-primary-button" text="NOCH EINMAL KÄMPFEN" />
                        <Button fx:id="homeButton" maxWidth="280.0" mnemonicParsing="false" onAction="#onExitClicked" prefHeight="42.0" styleClass="result-secondary-button" text="ZURÜCK ZUM HAUPTMENÜ" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
