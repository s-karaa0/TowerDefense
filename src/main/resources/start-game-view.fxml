<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.MotionBlur?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="720.0" prefWidth="1280.0" spacing="15.0" style="-fx-background-color: #1e1e2e;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.towerdefense.StartController">

   <children>
      <!-- Titel doppelt übereinander (StackPane) -->
      <StackPane>
         <VBox.margin>
            <Insets bottom="30.0" />
         </VBox.margin>
         <children>

            <!-- Vorderer / Oberer Text -->
            <Label text="Tower Defense Game" textFill="#fae588">
               <font>
                  <Font name="Bebas Neue Regular" size="76.0" />
               </font>
               <effect>
                  <MotionBlur radius="0.0" />
               </effect>
            </Label>
            <!-- Hinterer / Unterer Text (z.B. als dunklerer Schatten) -->
            <Label text="Tower Defense Game" textFill="#f7e499">
               <font>
                  <Font name="Bebas Neue Regular" size="76.0" />
               </font>
               <StackPane.margin>
                  <Insets left="4.0" top="4.0" />
               </StackPane.margin>
               <effect>
                  <MotionBlur radius="13.76" />
               </effect>
            </Label>
         </children>
      </StackPane>

      <Label text="select your difficulty!" textFill="#e0c96c">
         <font>
            <Font name="System Bold" size="28.0" />
         </font>
      </Label>

      <ChoiceBox fx:id="fieldChoiceBox" onAction="#choiceBoxClicked" prefWidth="250.0" style="-fx-background-color: #3A5D23; -fx-font-size: 14px; -fx-padding: 5px;" />

      <Button mnemonicParsing="false" onAction="#onStartButtonClicked" prefWidth="250.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-background-color: #627F33; -fx-text-fill: #FAE588; -fx-background-radius: 8px; -fx-cursor: hand;" text="Start">
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </Button>

      <Button mnemonicParsing="false" onAction="#onSettingsButtonClicked" prefWidth="60.0" style="-fx-font-size: 18px; -fx-background-color: #6D923F; -fx-text-fill: black; -fx-background-radius: 8px; -fx-cursor: hand;" text="⚙" />
   </children>

   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
</VBox>
