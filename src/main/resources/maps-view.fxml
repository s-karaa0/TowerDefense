<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.towerdefense.Controllers.MapController">
   <children>
      <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="200.0" layoutY="77.0" onMouseClicked="#mediumSelected" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/fields/field-normal_small.png" />
         </image>
      </ImageView>
      <ImageView fitHeight="150.0" fitWidth="200.0" layoutY="77.0" onMouseClicked="#easySelected" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/fields/field-easy_small.png" />
         </image>
      </ImageView>
      <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="400.0" layoutY="77.0" onMouseClicked="#hardSelected" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/fields/field-hard_small.png" />
         </image>
      </ImageView>
      <Label alignment="CENTER" layoutY="6.0" prefHeight="71.0" prefWidth="594.0" text="Map Selection">
         <font>
            <Font name="System Bold Italic" size="48.0" />
         </font>
      </Label>
      <Button fx:id="startButton" layoutX="268.0" layoutY="284.0" mnemonicParsing="false" onAction="#start" text="Start" />
   </children>
</AnchorPane>
