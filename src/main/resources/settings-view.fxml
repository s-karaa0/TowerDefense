<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" styleClass="settings-screen" stylesheets="@style/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.towerdefense.Controllers.SettingsController">
    <children>
        <VBox alignment="CENTER" spacing="16.0" AnchorPane.bottomAnchor="32.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="32.0">
            <children>
                <Label styleClass="eyebrow" text="DIE KRONENLAND-CHRONIK" />
                <Label styleClass="settings-title" text="EINSTELLUNGEN" />
                <Label styleClass="game-subtitle" text="Wähle die Haltung deiner Barden und Trommler" />
                <Label styleClass="ornament" text="✦   ━━━━━━━━━   ✦" />
                <VBox alignment="CENTER_LEFT" maxWidth="520.0" spacing="18.0" styleClass="settings-card">
                    <children>
                        <Label styleClass="settings-section-title" text="AUDIO" />
                        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="settings-row">
                            <children>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="settings-label" text="Hintergrundmusik" />
                                        <Label fx:id="currentTrackLabel" styleClass="settings-description" text="Die Barden spielen: Keine Musik" />
                                    </children>
                                </VBox>
                                <Button fx:id="musicButton" mnemonicParsing="false" onAction="#onMusicButtonClicked" styleClass="settings-toggle" text="MUSIK: AN" />
                            </children>
                        </HBox>
                        <Button fx:id="skipButton" mnemonicParsing="false" onAction="#onSkipClicked" styleClass="settings-secondary" text="NÄCHSTE MELODIE" />
                    </children>
                </VBox>
                <HBox alignment="CENTER" spacing="14.0">
                    <children>
                        <Button fx:id="closeButton" mnemonicParsing="false" onAction="#onExitClicked" styleClass="settings-secondary" text="ZURÜCK" />
                        <Button fx:id="continueButton" mnemonicParsing="false" onAction="#onContinueClicked" styleClass="settings-primary" text="Zurück zur Schlacht" />
                    </children>
                </HBox>
                <Label styleClass="footer-text" text="DAS REICH WARTET AUF DEINEN BEFEHL." />
            </children>
        </VBox>
    </children>
</AnchorPane>
